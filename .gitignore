# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── Generated Native Folders (managed workflow) ──────────────────────────────
/android
/ios
.kotlin/

# ─── Environment Variables ────────────────────────────────────────────────────
# Keep .env.example if you have one, but never commit real env files
.env
.env.local
.env.*.local
.env.development
.env.preview
.env.production

# ─── Firebase ─────────────────────────────────────────────────────────────────
# google-services.json contains no secret keys for this project (public config)
# but if you prefer to keep it private, uncomment the line below:
# google-services.json
# GoogleService-Info.plist

# ─── Certificates & Keys ──────────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.pem

# ─── Metro Bundler ────────────────────────────────────────────────────────────
.metro-health-check*

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Debug Logs ───────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── EAS / Build Artifacts ────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
